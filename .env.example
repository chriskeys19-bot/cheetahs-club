# Public Supabase credentials. Copy this file to .env.local and fill both values.
# Project Settings → API. Use the anon (publishable) key only.
# Never put the service role key, SPLITWISE_API_KEY, or an OAuth secret in a Vite variable.
# Vite inlines VITE_ values into the browser bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public club Venmo handle, without @. Not a secret.
# Used for pay links until a captain refreshes Splitwise.
# After a refresh, the Edge secret VENMO_USERNAME is what the app shows.
# When both are unset, links use the placeholder handle cheetahs.
VITE_VENMO_USERNAME=cheetahs
