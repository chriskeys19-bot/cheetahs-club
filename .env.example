# Public Supabase credentials. Copy this file to .env.local and fill both values.
# Project Settings → API. Use the anon (publishable) key only.
# Never put the service role key, SPLITWISE_API_KEY, or an OAuth secret in a Vite variable.
# Vite inlines VITE_ values into the browser bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Venmo pay buttons, links, and the staff setup note. Off unless this is true.
# Leave it unset until the club is ready to collect on Venmo.
# VITE_VENMO_ENABLED=true

# Public club Venmo handle, without @. Not a secret. Ignored while Venmo is off.
# Used only when VITE_VENMO_ENABLED=true, and only until a captain refreshes Splitwise.
# After a refresh, a real VENMO_USERNAME edge secret is what pay links use.
# Do not set the old placeholder cheetahs. An unset handle shows no pay link.
# VITE_VENMO_USERNAME=the-club-handle

# Comma-separated emails that see the header "View as" switcher.
# This is a UI preview only. It does not change the profile role or RLS.
# Unset uses chriskeys19@gmail.com.
VITE_ROLE_SWITCH_EMAILS=chriskeys19@gmail.com
